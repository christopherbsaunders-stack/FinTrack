# FinTrack as a service on Ubuntu. deploy/install.sh fills in the two @...@
# paths and copies this to /etc/systemd/system/fintrack.service.
[Unit]
Description=FinTrack personal finance dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fintrack
Group=fintrack
WorkingDirectory=@APP_DIR@
Environment=FINTRACK_DATA=/var/lib/fintrack/state.json
# Password, the names it answers to, the time zone: see /etc/fintrack.env.
EnvironmentFile=/etc/fintrack.env
ExecStart=@NODE@ src/server.js
Restart=on-failure
RestartSec=5

# FinTrack only needs to read its code and write its data folder.
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/fintrack
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
