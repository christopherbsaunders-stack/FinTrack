# FinTrack's settings on a home server. deploy/install.sh copies this to
# /etc/fintrack.env (readable only by root); edit it there, then:
#   sudo systemctl restart fintrack

# Listen on the network, not just this machine.
HOST=0.0.0.0
PORT=4600

# Required: the password for opening FinTrack in a browser (any user name).
# Put it in double quotes, like FINTRACK_PASSWORD="long password here".
FINTRACK_PASSWORD=

# Required: every name or address you'll type to reach it, separated by
# commas. The port is added if you leave it off. For example:
#   basement,basement.local,192.168.1.20
# Add the Tailscale name (and 100.x address) too if you use Tailscale.
FINTRACK_ALLOWED_HOSTS=

# Your time zone: FinTrack records each day and counts paydays by it.
# List the names with: timedatectl list-timezones
TZ=America/New_York

# Where the data lives (the service's own folder).
FINTRACK_DATA=/var/lib/fintrack/state.json

# Optional: keep backups somewhere else too, like a mounted NAS folder.
# The service may only write there once allowed: sudo systemctl edit fintrack
# and add [Service] ReadWritePaths=/mnt/nas/fintrack
# FINTRACK_BACKUP_DIR=/mnt/nas/fintrack
